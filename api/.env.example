# Salin ke api/.env lalu isi. Jangan commit .env.
# Supabase: Project Settings -> Database -> Connection string (mode "Transaction"/pooler).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Untuk `prisma migrate`: pakai koneksi langsung/Direct (port 5432), bukan pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=development
# Wajib di produksi; generate: openssl rand -base64 48
AUTH_SECRET="dev-only-change-me"
COOKIE_SECURE=false
ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
APP_ORIGIN="http://127.0.0.1:5173"

# Google OAuth (ID + secret wajib bersama; redirect URI lokal default ke port API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Produksi wajib eksplisit dan harus didaftarkan di Google Cloud.
GOOGLE_REDIRECT_URI="http://127.0.0.1:4000/api/v1/auth/google/callback"

# SMTP opsional: kosongkan untuk dev sink (link email dicetak ke konsol worker).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tracker <no-reply@tracker.local>"

# Worker outbox. Nilai default ini cocok untuk development dan deployment awal.
EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_LOCK_MS=60000
EMAIL_WORKER_MAX_ATTEMPTS=5
